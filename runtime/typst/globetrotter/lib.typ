// Renders translations from a module generated by globetrotter's `typst` output.
//
// The generated module carries data only: `version`, `engine`, `languages`, `arguments`, and
// `translations`.
// This package validates each call against `arguments` and renders a subset of Handlebars.
// Every invalid call or unsupported template construct panics, so a faulty translation fails the
// document's compilation instead of printing wrong text.

// The module format version this runtime reads.
#let format-version = "1"

// Typst types accepted for each globetrotter argument type.
// `number` follows the other generated bindings, which treat it as an integer.
// `float` also accepts integers because a whole number is a valid float value.
#let accepted-types = (
  any: none,
  string: (str,),
  isodatetime: (str,),
  number: (int,),
  integer: (int,),
  float: (int, float),
  boolean: (bool,),
)

// A path segment is a bracketed literal or a run of characters Handlebars allows in identifiers.
#let segment-pattern = "\\[[^\\]]+\\]|[^\\s!\"#%&'()*+,./;<=>@\\[\\\\\\]^`{|}~]+"
#let path-pattern = regex(
  "^(?:" + segment-pattern + ")(?:[./](?:" + segment-pattern + "))*$",
)
#let word-pattern = regex("\"[^\"]*\"|'[^']*'|(?:\\[[^\\]]*\\]|[^\\s\\[\"'])+")
#let number-pattern = regex("^-?[0-9]+(?:\\.[0-9]+)?$")
#let helper-name-pattern = regex("^[A-Za-z_][A-Za-z0-9_-]*$")

#let fail(key, message) = panic("globetrotter: key " + repr(key) + ": " + message)

#let type-name(value) = if value == none { "none" } else { repr(type(value)) }

// Splits a source string into text and tag tokens.
#let tokenize(key, source) = {
  let tokens = ()
  let rest = source
  while true {
    let open = rest.position("{{")
    if open == none {
      if rest != "" { tokens.push((kind: "text", value: rest)) }
      break
    }
    let text = rest.slice(0, open)
    // Handlebars escapes a mustache with a preceding backslash, which this subset does not support.
    if text.ends-with("\\") {
      fail(key, "escaped mustache \"\\{{\" is not supported")
    }
    if text != "" { tokens.push((kind: "text", value: text)) }
    let tail = rest.slice(open)
    let (opener, closer) = if tail.starts-with("{{!--") {
      ("{{!--", "--}}")
    } else if tail.starts-with("{{{") {
      ("{{{", "}}}")
    } else {
      ("{{", "}}")
    }
    let body = tail.slice(opener.len())
    let close = body.position(closer)
    if close == none {
      fail(key, "unterminated " + repr(opener) + " tag")
    }
    let inner = body.slice(0, close)
    rest = body.slice(close + closer.len())
    if opener == "{{!--" or (opener == "{{" and inner.starts-with("!")) {
      continue
    }
    tokens.push((kind: "tag", value: inner.trim(), source: opener + inner + closer))
  }
  tokens
}

#let parse-path(key, construct, path) = {
  if path.match(path-pattern) == none {
    fail(key, "unsupported path in " + repr(construct))
  }
  let segments = path.matches(regex(segment-pattern)).map(m => {
    if m.text.starts-with("[") { m.text.slice(1, -1) } else { m.text }
  })
  if segments.first() == "this" {
    fail(key, "unsupported path in " + repr(construct))
  }
  segments
}

// Parses a helper parameter: a string literal, a number literal, or a path.
#let parse-param(key, construct, word) = {
  if word.starts-with("\"") or word.starts-with("'") {
    (kind: "literal", value: word.slice(1, -1))
  } else if word.match(number-pattern) != none {
    (kind: "literal", value: if word.contains(".") { float(word) } else { int(word) })
  } else if word.contains("=") {
    fail(key, "hash arguments are not supported in " + repr(construct))
  } else {
    (kind: "path", path: parse-path(key, construct, word))
  }
}

// Splits an expression into words, keeping quoted strings and bracketed segments whole.
#let words(key, construct, expression) = {
  let found = expression.matches(word-pattern)
  let position = 0
  for word in found {
    if expression.slice(position, word.start).trim() != "" {
      fail(key, "malformed expression " + repr(construct))
    }
    position = word.end
  }
  if expression.slice(position).trim() != "" {
    fail(key, "malformed expression " + repr(construct))
  }
  found.map(word => word.text)
}

// Classifies one tag token.
#let classify(key, token) = {
  let tag = token.value
  let construct = token.source
  // Whitespace control, partials, inverse sections, data variables, decorators, and
  // subexpressions are outside the supported subset.
  if (
    tag == ""
      or tag.ends-with("~")
      or tag.first() in ("~", ">", "^", "&", "@", "*", "(", "!", "=")
  ) {
    fail(key, "unsupported construct " + repr(construct))
  }
  if tag == "else" {
    return (kind: "else", source: construct)
  }
  if tag.starts-with("#") {
    let parts = words(key, construct, tag.slice(1))
    if parts.len() != 2 or parts.first() not in ("if", "unless") {
      fail(key, "unsupported block " + repr(construct))
    }
    return (
      kind: "open",
      helper: parts.first(),
      path: parse-path(key, construct, parts.last()),
      source: construct,
    )
  }
  if tag.starts-with("/") {
    return (kind: "close", helper: tag.slice(1).trim(), source: construct)
  }
  let parts = words(key, construct, tag)
  let first = parts.first()
  if parts.len() == 1 {
    return (kind: "value", path: parse-path(key, construct, first), source: construct)
  }
  if first.match(helper-name-pattern) == none or first == "else" {
    fail(key, "unsupported construct " + repr(construct))
  }
  (
    kind: "helper",
    name: first,
    params: parts.slice(1).map(word => parse-param(key, construct, word)),
    source: construct,
  )
}

// Parses tokens from `start` until a block terminator or the end.
// Returns the nodes, the index after the terminator, and the terminator itself.
#let parse-nodes(key, tokens, start) = {
  let nodes = ()
  let index = start
  while index < tokens.len() {
    let token = tokens.at(index)
    index += 1
    if token.kind == "text" {
      nodes.push(token)
      continue
    }
    let tag = classify(key, token)
    if tag.kind in ("else", "close") {
      return (nodes, index, tag)
    }
    if tag.kind != "open" {
      nodes.push(tag)
      continue
    }

    // Block body, optional inverse after `{{else}}`, and the matching close tag
    let (body, after-body, end) = parse-nodes(key, tokens, index)
    let inverse = ()
    if end != none and end.kind == "else" {
      let (nested, after-inverse, inverse-end) = parse-nodes(key, tokens, after-body)
      inverse = nested
      after-body = after-inverse
      end = inverse-end
    }
    if end == none or end.kind != "close" or end.helper != tag.helper {
      fail(key, repr(tag.source) + " has no matching \"{{/" + tag.helper + "}}\"")
    }
    nodes.push((kind: "block", helper: tag.helper, path: tag.path, body: body, inverse: inverse))
    index = after-body
  }
  (nodes, index, none)
}

// Parses a template into a node tree; Typst memoizes this pure function per source.
#let parse(key, source) = {
  let (nodes, _, end) = parse-nodes(key, tokenize(key, source), 0)
  if end != none {
    fail(key, "unexpected " + repr(end.source))
  }
  nodes
}

// Formats a value as Handlebars would, with ASCII minus signs like the JSON data.
#let text-of(key, construct, value) = {
  let kind = type(value)
  if kind == str {
    value
  } else if kind in (int, float, decimal) {
    str(value).replace("\u{2212}", "-")
  } else if kind == bool {
    if value { "true" } else { "false" }
  } else if value == none {
    ""
  } else {
    fail(key, "cannot render a value of type " + type-name(value) + " in " + repr(construct))
  }
}

// Applies Handlebars truthiness: none, false, zero, empty strings, and empty arrays are false.
#let truthy(value) = value not in (none, false, 0, 0.0, "", ())

#let lookup(key, construct, values, path) = {
  let name = path.first()
  if name not in values {
    fail(key, repr(construct) + " references undeclared argument " + repr(name))
  }
  let value = values.at(name)
  for segment in path.slice(1) {
    if type(value) != dictionary or segment not in value {
      fail(key, repr(construct) + " has no field " + repr(segment))
    }
    value = value.at(segment)
  }
  value
}

#let call-helper(key, construct, helpers, name, params) = {
  if name not in helpers {
    fail(key, repr(construct) + " calls unknown helper " + repr(name))
  }
  text-of(key, construct, (helpers.at(name))(..params))
}

#let render(key, nodes, values, helpers) = {
  let output = ""
  for node in nodes {
    output += if node.kind == "text" {
      node.value
    } else if node.kind == "value" {
      // Like Handlebars, a registered helper takes precedence over an argument of the same name.
      if node.path.len() == 1 and node.path.first() in helpers {
        call-helper(key, node.source, helpers, node.path.first(), ())
      } else {
        text-of(key, node.source, lookup(key, node.source, values, node.path))
      }
    } else if node.kind == "helper" {
      let params = node.params.map(param => if param.kind == "literal" {
        param.value
      } else {
        lookup(key, node.source, values, param.path)
      })
      call-helper(key, node.source, helpers, node.name, params)
    } else {
      let condition = truthy(lookup(key, "{{#" + node.helper + "}}", values, node.path))
      let selected = if (node.helper == "if") == condition { node.body } else { node.inverse }
      render(key, selected, values, helpers)
    }
  }
  output
}

// Checks named values against a key's declared argument types.
#let validate(key, values, declared) = {
  for name in values.keys() {
    if name not in declared {
      fail(key, "unexpected argument " + repr(name))
    }
  }
  for (name, kind) in declared {
    if name not in values {
      fail(key, "missing argument " + repr(name))
    }
    if kind not in accepted-types {
      fail(key, "argument " + repr(name) + " has unsupported type " + repr(kind))
    }
    let accepted = accepted-types.at(kind)
    let value = values.at(name)
    if accepted != none and type(value) not in accepted {
      fail(
        key,
        "argument " + repr(name) + " must be " + kind + ", found " + type-name(value),
      )
    }
  }
}

/// Returns a translation function for one language of a generated module.
///
/// - module (module, dictionary): The generated module, such as
///   `#import "translations.typ" as catalog`.
/// - lang (str): A language code listed in the module's `languages`.
/// - helpers (dictionary): Helper functions by name, called with the evaluated parameters of
///   `{{name param ...}}` and returning a `str`, number, boolean, or `none`.
/// -> function
///
/// The returned `t(key, ..arguments)` takes a key and the key's declared arguments by name, and
/// returns the rendered `str`.
/// It panics on an unknown key, a positional value, and a missing, unexpected, or mistyped
/// argument.
#let translator(module, lang, helpers: (:)) = {
  if module.version != format-version {
    panic(
      "globetrotter: module format version " + repr(module.version) + " is not supported, "
        + "expected " + repr(format-version),
    )
  }
  if module.engine not in (none, "handlebars") {
    panic("globetrotter: template engine " + repr(module.engine) + " is not supported")
  }
  if type(lang) != str or lang not in module.languages {
    panic(
      "globetrotter: unknown language " + repr(lang) + ", expected one of "
        + repr(module.languages),
    )
  }
  for (name, helper) in helpers {
    if type(helper) != function {
      panic("globetrotter: helper " + repr(name) + " is not a function")
    }
  }
  let catalog = module.translations.at(lang)
  (key, ..arguments) => {
    if type(key) != str or key not in module.arguments or key not in catalog {
      panic("globetrotter: unknown translation key " + repr(key))
    }
    if arguments.pos().len() > 0 {
      fail(key, "arguments must be named, found positional " + repr(arguments.pos()))
    }
    let declared = module.arguments.at(key)
    let values = arguments.named()
    validate(key, values, declared)
    let source = catalog.at(key)

    // A key without arguments is a literal and may contain mustaches verbatim.
    if declared.len() == 0 {
      return source
    }
    if module.engine == none {
      fail(key, "declares arguments, but the module has no template engine")
    }
    render(key, parse(key, source), values, helpers)
  }
}
